<div class="container mt-4">
	<div class="row">
		<div class="col-2"></div>
		<div class="col-8">
			<div class="row">
				<div class="col-3"></div>
				<div class="col-6">
					<h2>プランを作成</h2>
					<%= form_with model: @plan do |f| %>
						<span class="text-danger">*</span>
						<%= f.label :plan_name %></br >
						<div class="d-grid col-12 mb-2">
							<%= f.text_field :plan_name %>
						</div>
						<%= f.label :plan_image %></br >
						<div class="d-grid col-12 mb-2">
							<%= f.file_field :plan_image %>
						</div>
						<%= f.label :plan_introduction %></br >
						<div class="d-grid col-12 mb-4">
							<%= f.text_area :plan_introduction %>
						</div>
						<%= f.submit "作成", class: "btn btn-primary me-1" %>
						<%= link_to :back, class: "btn btn-primary" do %>
							キャンセル
						<% end %>
					<% end %>
				</div>
				<div class="col-3"></div>
			</div>
    </div>
		<div class="col-2"></div>
	</div>
</div>
