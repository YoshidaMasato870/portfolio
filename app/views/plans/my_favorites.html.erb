<div class="container mt-4">
	<div class="row">
		<div class="col-2"></div>
		<div class="col-8">
			<h2 class="mb-4">いいね一覧</h2>
			<% if @favorite_plans.present? %>
				<table class="table table-striped">
					<thead>
						<tr>
							<th scope="col" style="width: 8%"></th>
							<th scope="col" style="width: 20%">プラン名</th>
							<th scope="col" style="width: 12%">エリア</th>
							<th scope="col" style="width: 34%">プラン紹介</th>
							<th scope="col" style="width: 8%">詳細</th>
							<th scope="col" style="width: 8%"></th>
						</tr>
					</thead>
					<tbody>
						<% @favorite_plans.each do |plan| %>
						<tr>
							<th><%= image_tag plan.image.url, size: "50x50" %></th>
							<th><%= plan.name %></th>
							<th><%= change_area(plan.area_id) %></th>
							<th><%= plan.introduction %></th>
							<th>
								<%= link_to plan_path(plan.id), class: "btn btn-sm btn-primary" do %>
									詳細
								<% end %>
							</th>
							<th>
								<%= render "favorites/btn", plan: plan %>
							</th>
						</tr>
						<% end %>
					</tbody>
				</table>
				<%= paginate @favorite_plans, theme: 'bootstrap-5' %>
				<% else %>
					<h4 class="mt-2">プランはありません</h4>
				<% end %>
			</table>
			<div class="d-flex flex-row-reverse me-3">
				<div><%= link_to "ホームに戻る", root_path, class: "btn btn-primary ms-3 mb-5" %></div>
			</div>

		</div>
		<div class="col-2"></div>
    </div>
</div>
