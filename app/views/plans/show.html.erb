<div class="container mt-4">
	<div class="row">
		<div class="col-3"></div>
		<div class="col-6">
			<h2>プラン詳細</h2>
			<% if user_signed_in? %>
				<div class="d-flex flex-row-reverse mb-2">
					<div class="col-2 me-4"><%= link_to "プランを編集", edit_plan_path(@plan.id) %></div>
				</div>
			<% end %>
			<div class="d-flex flex-row mt-4 mb-2">
				<div class="me-4">
					<%= image_tag @plan.image.url, size: "100x100" %>
				</div>
				<h3><%= @plan.name %></h3>
			</div>
			<table class="mb-4">
				<tr>
					<th>エリア</th>
					<td><%= change_area(@plan.area_id) %></td>
				</tr>
				<tr>
					<th>プラン詳細</th>
					<td><%= @plan.introduction %></td>
				</tr>
			</table>

			<h3>観光地</h3>
			<% @plan_spots.each do |spot| %>
			<table class="mb-3">
				<tr>
					<td><%= image_tag spot.image.url, size: "75x75" %></td>
				</tr>
				<tr>
					<th>名称</th>
					<td><%= spot.name %></td>
				</tr>
				<tr>
					<th>詳細</th>
					<td><%= spot.introduction %></td>
				</tr>
			</table>	
			<% end %>

			<div class="d-flex flex-row-reverse mb-2">
				<div class="col-2">
					<% if user_signed_in? %>
						<%= link_to "戻る", myplan_plan_path(@plan.user_id), class: "btn btn-primary" %>
					<% else %>
						<%= link_to "戻る", :back %>
					<% end %>
				</div>
			</diiv>
		</div>
		<div class="col-3"></div>
	</div>
</div>
