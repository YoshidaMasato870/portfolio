<div class="container mt-4">
	<div class="row">
		<div class="col-3"></div>
		<div class="col-6">
			<h2>プラン詳細</h2>
				<% if user_signed_in? %>
					<% if @plan.user_id == current_user.id %>
						<div class="d-flex flex-row-reverse mb-2">
							<div class="col-2 me-4"><%= link_to "プランを編集", edit_plan_path(@plan.id) %></div>
						</div>
					<% end %>
				<% end %>
			<div class="d-flex flex-row mt-4 mb-2">
				<div class="me-4">
					<%= image_tag @plan.image.url, size: "100x100" %>
				</div>
				<div class="row">
					<table>
						<tr><h3><%= @plan.name %></h3></tr>
						<tr>
							<th scope="col" style="width: 5%"></th>
							<th scope="col" style="width: 25%">作成者</th>
							<td scope="col" style="width: 70%">
								<% if user_signed_in? && @plan.user_id == current_user.id %>
									<h4><%= @plan_owner.name %></h4>
								<% else %>
									<%= link_to user_info_plan_path(@plan.user_id) do %>
										<h4><%= @plan_owner.name %></h4>
									<% end %>
								<% end %>
							</td>
						</tr>
						<tr>
							<th></th>
							<th>いいね数</th>
							<td>
								<%= @plan_favorited_by.count %>  <i class="fa fa-thumbs-o-up"></i>
							</td>
						</tr>
					</table>
				</div>
			</div>
			<table class="mb-4">
				<tr>
					<th>エリア</th>
					<td><%= change_area(@plan.area_id) %></td>
				</tr>
				<tr>
					<th>プラン詳細</th>
					<td><%= @plan.introduction %></td>
				</tr>
			</table>

			<% if @plan_spots.exists? %>
				<h3>観光地</h3>
			<% end %>
			<% @plan_spots.each do |spot| %>
			<table class="mb-3">
				<tr>
					<td><%= image_tag spot.image.url, size: "75x75" %></td>
				</tr>
				<tr>
					<th>名称</th>
					<td><%= spot.name %></td>
				</tr>
				<tr>
					<th>詳細</th>
					<td><%= spot.introduction %></td>
				</tr>
			</table>	
			<% end %>

			<div class="d-flex flex-row-reverse mb-2">
				<% if user_signed_in? && @plan.user_id == current_user.id %>
					<div class="col-4">
						<%= link_to "作成済みプランに戻る", myplan_plan_path(current_user.id), class: "btn btn-primary" %>
					</div>
				<% else %>
					<div>
						<%= link_to "プラン一覧に戻る", plans_path, class: "btn btn-primary" %>
						<%= link_to "ホームに戻る", root_path, class: "btn btn-primary" %>
					</div>
				<% end %>
			</div>
		</div>
		<div class="col-3"></div>
	</div>
</div>
