<div class="nested-fields">
	<div>
		<%= f.label :name %>
	</div>
	<div class="d-grid col-12 mb-2">
		<%= f.text_field :name %>
	</div>
	<div>
		<%= f.label :image %>
	</div>
	<div class="d-grid col-12 mb-2">
		<%= f.file_field :image %>
	</div>
	<div>
		<%= f.label :introduction %>
	</div>
	<div class="d-grid col-12 mb-2">
		<%= f.text_area :introduction %>
	</div>
	<div class="d-flex flex-row-reverse mb-2">
		<div>
			<%= link_to_remove_association "削除する", f, class: "btn btn-info" %>
		</div>
	</div>
</div>
