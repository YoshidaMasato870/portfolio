<div class="container mt-5">
  <div class="row">
    <div class="col-md-3 col-sm-2"></div>
    <div class="col-md-6 col-sm-8">
      <div class="row">
        <div class="col-3"></div>
        <div class="col-6">
          <h2>ログイン</h2>
          <%= form_for(resource, as: resource_name, url: session_path(resource_name)) do |f| %>
            <div class="field">
              <%= f.label :account_name %><br />
              <div class="d-grid col-12 mb-2">
                <%= f.text_field :account_name, autofocus: true, autocomplete: "account", placeholder: "アカウント名を入力" %>
              </div>
            </div>

            <div class="field mb-3">
              <%= f.label :password %><br />
              <div class="d-grid col-12">
                <%= f.password_field :password, autocomplete: "current-password", placeholder: "パスワードを入力" %>
              </div>
            </div>

            <div class="d-grid col-6 mx-auto">
              <div class="actions mb-2">
                <%= f.submit "ログイン", class: "btn btn-primary" %>
              </div>
            </div>
          <% end %>
          <%= render "devise/shared/links" %>
        </div>
        <div=class="col-3"></div>
      </div>
    </div>
    <div class="col-md-3 col-sm-2"></div>
  </div>
</div>
