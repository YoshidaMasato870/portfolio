<% if plan.favorited_by?(current_user) %>
	<%= button_to plan_favorite_path(plan), method: :delete do %>
		<%= plan.favorites.count %>
		<i class="fa fa-thumbs-up"></i>
	<% end %>
<% else %>
	<%= button_to plan_favorite_path(plan), method: :post do %>
		<%= plan.favorites.count %>
		<i class="fa fa-thumbs-o-up"></i>
	<% end %>
<% end %>
